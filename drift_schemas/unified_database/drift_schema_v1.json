  "fixed_sql": [
    {
      "name": "profiles",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"profiles\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL UNIQUE, \"sort_order\" INTEGER NOT NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "app_state",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_state\" (\"id\" INTEGER NOT NULL DEFAULT 1, \"active_profile_id\" TEXT NULL REFERENCES profiles (id) ON DELETE SET NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "app_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_settings\" (\"key\" TEXT NOT NULL, \"value_type\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "trades",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"trades\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"profile_id\" TEXT NOT NULL REFERENCES profiles (id) ON DELETE CASCADE, \"symbol\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"quantity\" REAL NOT NULL, \"price\" REAL NOT NULL, \"trade_type\" TEXT NOT NULL, \"trade_date\" INTEGER NOT NULL, \"realized_p_l\" REAL NOT NULL DEFAULT 0.0, \"commission\" REAL NOT NULL DEFAULT 0.0);"
        }
      ]
    },
    {
      "name": "ibkr_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"ibkr_settings\" (\"profile_id\" TEXT NOT NULL REFERENCES profiles (id) ON DELETE CASCADE, \"enabled\" INTEGER NOT NULL DEFAULT 0 CHECK (\"enabled\" IN (0, 1)), \"base_url\" TEXT NOT NULL DEFAULT '', \"token\" TEXT NOT NULL DEFAULT '', PRIMARY KEY (\"profile_id\"));"
        }
      ]
    },
    {
      "name": "ibkr_cache_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"ibkr_cache_entries\" (\"profile_id\" TEXT NOT NULL REFERENCES profiles (id) ON DELETE CASCADE, \"kind\" TEXT NOT NULL, \"cache_key\" TEXT NOT NULL, \"payload_json\" TEXT NOT NULL, \"cached_at\" INTEGER NOT NULL, PRIMARY KEY (\"profile_id\", \"kind\", \"cache_key\"));"
        }
      ]
    },
    {
      "name": "candles",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"candles\" (\"symbol\" TEXT NOT NULL, \"date\" INTEGER NOT NULL, \"open\" REAL NOT NULL DEFAULT -1.0, \"high\" REAL NOT NULL DEFAULT -1.0, \"low\" REAL NOT NULL DEFAULT -1.0, \"close\" REAL NOT NULL DEFAULT -1.0, \"volume\" INTEGER NOT NULL DEFAULT 0, \"adj_close\" REAL NOT NULL DEFAULT -1.0, PRIMARY KEY (\"symbol\", \"date\"));"
        }
      ]
    },
    {
      "name": "symbol_metadata",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"symbol_metadata\" (\"symbol\" TEXT NOT NULL, \"display_name\" TEXT NULL, \"currency\" TEXT NULL, \"exchange\" TEXT NULL, \"quote_type\" TEXT NULL, \"payload_json\" TEXT NULL, \"cached_at\" INTEGER NOT NULL, PRIMARY KEY (\"symbol\"));"
        }
      ]
