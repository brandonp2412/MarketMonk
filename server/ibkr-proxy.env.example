IBKR_GATEWAY_URL=https://127.0.0.1:5000/v1/api
# Optional when the gateway exposes exactly one account.
IBKR_ACCOUNT_ID=
# The official Client Portal Gateway uses a self-signed localhost certificate by default.
# Leave unset to verify TLS for remote hosts and accept the default localhost certificate.
IBKR_GATEWAY_VERIFY_TLS=
MARKET_MONK_IBKR_BIND=127.0.0.1
MARKET_MONK_IBKR_PORT=8091
MARKET_MONK_IBKR_TOKEN=
