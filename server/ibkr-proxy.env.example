# Backend: native (TWS / IB Gateway socket API) or client_portal (Web API).
IBKR_BACKEND=native

# Optional when the logged-in Gateway exposes exactly one account.
IBKR_ACCOUNT_ID=

# Native TWS / IB Gateway backend.
IBKR_TWS_HOST=127.0.0.1
IBKR_TWS_PORT=4001
IBKR_TWS_CLIENT_ID=97

# Client Portal backend only.
IBKR_GATEWAY_URL=https://127.0.0.1:5000/v1/api
# Leave unset to verify TLS for remote hosts and accept the default localhost certificate.
IBKR_GATEWAY_VERIFY_TLS=

MARKET_MONK_IBKR_BIND=127.0.0.1
MARKET_MONK_IBKR_PORT=8091
MARKET_MONK_IBKR_TOKEN=
