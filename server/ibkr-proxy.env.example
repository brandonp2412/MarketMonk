# Backend: native (TWS / IB Gateway socket API) or client_portal (Web API).
IBKR_BACKEND=native

# Optional when the logged-in Gateway exposes exactly one account.
IBKR_ACCOUNT_ID=

# Native TWS / IB Gateway backend.
IBKR_TWS_HOST=127.0.0.1
IBKR_TWS_PORT=4001
IBKR_TWS_CLIENT_ID=97

# Client Portal Gateway used when IBKR_BACKEND=client_portal.
IBKR_GATEWAY_URL=https://127.0.0.1:5000/v1/api
# Leave unset to verify TLS for remote hosts and accept the default localhost certificate.
IBKR_GATEWAY_VERIFY_TLS=

# In native mode, use an isolated Client Portal Gateway/session for PortfolioAnalyst.
# The helper prints the raw /pa/performance response, which this proxy validates
# against IBKR_ACCOUNT_ID before exposing it to MarketMonk.
MARKET_MONK_IBKR_PERFORMANCE_COMMAND=/opt/ibkrbot/app/bin/ibkr-daily-bot web-performance
IBKR_BROKER_BACKEND=web
IBKR_WEB_API_URL=https://127.0.0.1:5002/v1/api/
IBKR_WEB_IBC_CONFIG=/etc/ibkrbot/ibc-market-monk.ini
IBKR_WEB_TOTP_SEED=/etc/ibkrbot/ibkr-market-monk.totp
IBKR_WEB_AUTH_STATE=/var/lib/market-monk-ibkr/web-auth.json
IBKR_BASE_CURRENCY=NZD

MARKET_MONK_IBKR_BIND=127.0.0.1
MARKET_MONK_IBKR_PORT=8091
MARKET_MONK_IBKR_TOKEN=
